# Пример окружения. Реальные значения в .env.<окружение>, зашифрованные SOPS+age.
# Приложение не стартует, если обязательная переменная отсутствует (раздел 9.2 ТЗ).

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
PUBLIC_BASE_URL=http://localhost:8000

# --- База данных -------------------------------------------------------------
# Роль приложения: БЕЗ атрибута BYPASSRLS. Проверяется тестом изоляции тенантов.
DATABASE_URL=postgresql+asyncpg://aerogram_app:app@localhost:5432/aerogram
# Роль миграций: с правами на DDL. Отдельная от роли приложения.
DATABASE_MIGRATION_URL=postgresql+asyncpg://aerogram_migrator:migrator@localhost:5432/aerogram

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Безопасность ------------------------------------------------------------
# Не менее 32 символов. Сгенерировать: openssl rand -base64 48
JWT_SECRET=ЗАМЕНИТЬ_на_случайную_строку_не_короче_32_символов
# Ключи шифрования учётных данных ТК: "key_id:base64key[,key_id2:base64key]".
# Сгенерировать: python -c "from aerogram.shared.crypto import CredentialCipher as C; print(C.generate_key())"
CREDENTIAL_KEYS=k1:ЗАМЕНИТЬ_на_base64_ключ_32_байта
CREDENTIAL_ACTIVE_KEY_ID=k1

# --- Расчёт ------------------------------------------------------------------
CARRIER_TIMEOUT_SECONDS=3.0
RATING_DEADLINE_SECONDS=5.0
QUOTE_CACHE_TTL_SECONDS=900

# --- Внешние сервисы (в РФ, требование 152-ФЗ) -------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=aerogram
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Перевозчики -------------------------------------------------------------
# Только адреса сервисов. Логины и пароли перевозчиков в окружении НЕ хранятся:
# они у каждого тенанта свои и лежат зашифрованными в carrier_accounts.
# Как их завести — docs/integrations/major-express.md.
# Пусто = берётся адрес из самого WSDL.
MAJOR_EXPRESS_ENDPOINT_URL=

DADATA_TOKEN=
DADATA_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@app.aerogram.ru

SENTRY_DSN=
